<Page x:Class="TsubameViewer.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:TsubameViewer.Views"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:uwpControls="using:CommunityToolkit.WinUI.Controls"
      xmlns:tt="using:TsubameViewer.Views.TemplateSelector"
      xmlns:wst="using:WindowsStateTriggers"
      xmlns:vm="using:TsubameViewer.ViewModels"
      xmlns:i18Ext="using:I18NPortable.Xaml.Extensions"
      xmlns:winui="using:Microsoft.UI.Xaml.Controls"
      xmlns:sss="using:Windows.Globalization.NumberFormatting"
      xmlns:winUIControls="using:CommunityToolkit.WinUI.Controls"
      xmlns:ctwu="using:CommunityToolkit.WinUI"
      mc:Ignorable="d"
      >
  <Page.Resources>
    <DataTemplate x:Name="TitlebarContent"
                  x:DataType="vm:SettingsPageViewModel">
      <StackPanel Orientation="Horizontal"
                  Spacing="8"                   
                  HorizontalAlignment="Right">

      </StackPanel>
    </DataTemplate>
    
    <x:Double x:Key="SettingItemWidth">400</x:Double>
    <x:Double x:Key="GroupSpacing">48</x:Double>
    <x:Double x:Key="ItemsSpacing">24</x:Double>

    <Style TargetType="ToggleSwitch" BasedOn="{StaticResource ToggleSwitchNoHeader}" />

    <tt:SettingsItemTemplateSelector x:Key="SettingItemTemplateSelector">
      <tt:SettingsItemTemplateSelector.ToggleSwitchSettingItem>
        <DataTemplate x:DataType="vm:IToggleSwitchSettingItemViewModel">
          <winUIControls:SettingsCard Header="{x:Bind Label}"
                                      Description="{x:Bind Desc}"
                                      Visibility="{Binding IsVisible, Converter={StaticResource TrueToVisibleConverter}}">
            <ToggleSwitch IsOn="{x:Bind Value, Mode=TwoWay}"
                          uwpControls:DockPanel.Dock="Right"
                          Margin="0"
                          Padding="0"
                          ctwu:FrameworkElementExtensions.Cursor="Hand"/>
          </winUIControls:SettingsCard>
        </DataTemplate>
      </tt:SettingsItemTemplateSelector.ToggleSwitchSettingItem>

      <tt:SettingsItemTemplateSelector.SelectorSettingItem>
        <DataTemplate x:DataType="vm:ISelectorSettingsItemViewModel">
          <winUIControls:SettingsCard Header="{x:Bind Label}"
                                      Description="{x:Bind Desc}">
            <!--<winUIControls:Segmented ItemsSource="{x:Bind Items}"
                                     SelectedItem="{x:Bind SelectedItem, Mode=OneWay}"
                                     ItemTemplate="{StaticResource LocalizeTextTemplate}"
                                     SelectionChanged="Segmented_SelectionChanged" />-->

            <ListView ItemsSource="{x:Bind Items}"
                      SelectedItem="{x:Bind SelectedItem, Mode=TwoWay}"
                      ItemTemplate="{StaticResource LocalizeTextTemplate}"
                      SelectionChanged="Segmented_SelectionChanged"
                      Loaded="ListView_Loaded"
                      ctwu:FrameworkElementExtensions.Cursor="Hand"
                      MaxWidth="320">
              
            </ListView>
          </winUIControls:SettingsCard>
        </DataTemplate>
      </tt:SettingsItemTemplateSelector.SelectorSettingItem>

      <!-- アプリに記録されたフォルダ -->
      <tt:SettingsItemTemplateSelector.StoredFoldersSettingItem>
        <DataTemplate x:DataType="vm:StoredFoldersSettingItemViewModel">
          <StackPanel>
            <winUIControls:SettingsExpander ItemsSource="{x:Bind Folders}"
                                            Header="{i18Ext:Localize Key=Folders}">
              <winUIControls:SettingsExpander.ItemTemplate>
                <DataTemplate x:DataType="vm:StoredFolderViewModel">
                  <winUIControls:SettingsCard Header="{x:Bind FolderName}"
                                              Description="{x:Bind Path}">
                    <Button Content="{Binding Source=RemoveSourceFolderFromApp, Converter={StaticResource LocalizeConverter}}"
                            Command="{x:Bind DeleteStoredFolderCommand}"
                            ctwu:FrameworkElementExtensions.Cursor="Hand" />
                  </winUIControls:SettingsCard>
                </DataTemplate>
              </winUIControls:SettingsExpander.ItemTemplate>
            </winUIControls:SettingsExpander>
            <winUIControls:SettingsExpander ItemsSource="{x:Bind TempFiles}"
                                            Header="{i18Ext:Localize Key=RecentlyUsedFiles}">
              <winUIControls:SettingsExpander.ItemTemplate>
                <DataTemplate x:DataType="vm:StoredFolderViewModel">
                  <winUIControls:SettingsCard Header="{x:Bind FolderName}"
                                              Description="{x:Bind Path}">
                    <Button Content="{Binding Source=RemoveSourceFolderFromApp, Converter={StaticResource LocalizeConverter}}"
                            Command="{x:Bind DeleteStoredFolderCommand}"
                            ctwu:FrameworkElementExtensions.Cursor="Hand" />
                  </winUIControls:SettingsCard>
                </DataTemplate>
              </winUIControls:SettingsExpander.ItemTemplate>
            </winUIControls:SettingsExpander>
          </StackPanel>
        </DataTemplate>

      </tt:SettingsItemTemplateSelector.StoredFoldersSettingItem>

      <tt:SettingsItemTemplateSelector.UpdatableTextSettingItem>
        <DataTemplate x:DataType="vm:UpdatableTextSettingItemViewModel">
          <winUIControls:SettingsCard Visibility="{x:Bind IsVisible, Converter={StaticResource TrueToVisibleConverter}}"
                                      Header="{x:Bind Label}"
                                      Description="{x:Bind Text.Value, Mode=OneWay}" />
        </DataTemplate>
      </tt:SettingsItemTemplateSelector.UpdatableTextSettingItem>
      <tt:SettingsItemTemplateSelector.ButtonSettingItem>
        <DataTemplate x:DataType="vm:ButtonSettingItemViewModel">
          <winUIControls:SettingsCard Header="{x:Bind Label, Mode=OneWay}"
                                      Description="{x:Bind Description, Mode=OneWay}">
            <Button Content="{x:Bind ButtonLabel, Mode=OneWay}"
                    Command="{x:Bind ActionCommand}"
                    MaxWidth="{StaticResource SettingItemWidth}"
                    HorizontalAlignment="Right"
                    Visibility="{x:Bind IsVisible, Converter={StaticResource TrueToVisibleConverter}}"
                    Margin="0 16"
                    ctwu:FrameworkElementExtensions.Cursor="Hand" />
          </winUIControls:SettingsCard>
        </DataTemplate>
      </tt:SettingsItemTemplateSelector.ButtonSettingItem>
      <tt:SettingsItemTemplateSelector.ThemeSelectSettingItem>
        <DataTemplate x:DataType="vm:ThemeSelectSettingItemViewModel">
          <winUIControls:SettingsCard Header="{x:Bind Label}">
            <ComboBox ItemsSource="{x:Bind ThemeItems}"
                      SelectedItem="{x:Bind SelectedTheme, Mode=TwoWay}"
                      HorizontalAlignment="Right"
                      ctwu:FrameworkElementExtensions.Cursor="Hand">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Converter={StaticResource LocalizeConverter}}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </winUIControls:SettingsCard>
        </DataTemplate>
      </tt:SettingsItemTemplateSelector.ThemeSelectSettingItem>
      <tt:SettingsItemTemplateSelector.LocaleSelectSettingItem>
        <DataTemplate x:DataType="vm:LocaleSelectSettingItemViewModel">
          <winUIControls:SettingsCard Header="{x:Bind Label}">
            <StackPanel>
              <ComboBox ItemsSource="{x:Bind Locales}"
                        SelectedValue="{x:Bind SelectedLocale, Mode=OneWay}"
                        SelectionChanged="ComboBox_SelectionChanged"                        
                        HorizontalAlignment="Right"
                        ctwu:FrameworkElementExtensions.Cursor="Hand">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock>
                      <Run Text="{Binding DisplayName}" /> <Run Text="{Binding Locale}" />
                    </TextBlock>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <Button Content="{x:Bind RestartTextTranslated}"
                      Command="{x:Bind RestartApplicationCommand}"
                      Visibility="{x:Bind IsRequireRestart, Mode=OneWay, Converter={StaticResource TrueToVisibleConverter}}"
                      Margin="0 16 0 0"
                      ctwu:FrameworkElementExtensions.Cursor="Hand"/>
            </StackPanel>
          </winUIControls:SettingsCard>
        </DataTemplate>
      </tt:SettingsItemTemplateSelector.LocaleSelectSettingItem>
      <tt:SettingsItemTemplateSelector.NumericTextBoxSettingItem>
        <DataTemplate x:DataType="vm:NumberBoxSettingItemViewModel">
          <winUIControls:SettingsCard Header="{x:Bind Label}"
                                      Description="{x:Bind Desc}">
            <winui:NumberBox Value="{x:Bind FirstValue}"
                    ValueChanged="{x:Bind OnValueChanged}"
                    Minimum="{x:Bind MinValue}"
                    Maximum="{x:Bind MaxValue}"           
                    HorizontalAlignment="Right"
                    HorizontalContentAlignment="Right"
                    MinWidth="140"
                             SmallChange="{x:Bind ValueStep}"
                             LargeChange="{x:Bind ValueStep}"
                             SpinButtonPlacementMode="Compact"
                             x:Name="MyNumberBox"
                             >
              <winui:NumberBox.Header>
                <TextBlock Text="{x:Bind HeaderText, Mode=OneWay}" 
                           HorizontalAlignment="Right"
                           FontSize="16"
                           Margin="0 0 32 0"/>
              </winui:NumberBox.Header>
            </winui:NumberBox>
          </winUIControls:SettingsCard>
        </DataTemplate>
      </tt:SettingsItemTemplateSelector.NumericTextBoxSettingItem>
      <tt:SettingsItemTemplateSelector.SliderSettingItem>
        <DataTemplate x:DataType="vm:SliderSettingItemViewModel">
          <winUIControls:SettingsCard Header="{x:Bind Label}"
                                      Description="{x:Bind Desc}">
            <Slider Value="{x:Bind FirstValue}"
                    ValueChanged="{x:Bind OnValueChanged}"
                    Minimum="{x:Bind MinValue}"
                    Maximum="{x:Bind MaxValue}"
                    StepFrequency="{x:Bind ValueStep}"
                    TickFrequency="{x:Bind ValueStep}"
                    HorizontalAlignment="Right"
                    HorizontalContentAlignment="Right"
                    MinWidth="240"
                    ThumbToolTipValueConverter="{StaticResource DoubleToPercentTextConverter}"
                    x:Name="MySlider"
                    ctwu:FrameworkElementExtensions.Cursor="Hand">
              <Slider.Header>
                <TextBlock Text="{Binding ElementName=MySlider, Path=Value, Converter={StaticResource DoubleToPercentTextConverter}}"
                           HorizontalAlignment="Right" 
                           FontSize="16"/>
              </Slider.Header>
            </Slider>
          </winUIControls:SettingsCard>
        </DataTemplate>
      </tt:SettingsItemTemplateSelector.SliderSettingItem>
    </tt:SettingsItemTemplateSelector>

    <DataTemplate x:Key="SettingsGroupTemplate"
                  x:DataType="vm:SettingsGroupViewModel">
      <StackPanel Spacing="8" >
        <TextBlock Text="{x:Bind  Label}" Style="{StaticResource SubtitleTextBlockStyle}" />
        <ItemsControl ItemsSource="{x:Bind  Items}"
                      ItemTemplateSelector="{StaticResource SettingItemTemplateSelector}"
                      HorizontalAlignment="Stretch"                      
                      IsTabStop="False"
                        >
        </ItemsControl>
      </StackPanel>
    </DataTemplate>

    <Flyout x:Name="PurchaseThanksMassageFlyout">
      <TextBlock Text="{i18Ext:Localize Key=PurchaseAddon_PurchasedThanksMessage}"
                 TextWrapping="Wrap"
                 MaxWidth="320" />
    </Flyout>

    <Flyout x:Name="PurchaseConfirmFlyout">
      <StackPanel Spacing="16"
                  MaxWidth="300">

        <TextBlock Text="{i18Ext:Localize Key=PurchaseAddon_ButtonTitle}"
                   Style="{StaticResource SubtitleTextBlockStyle}" />

        <TextBlock x:Name="PurchaseConfirmFlyout_DescTextBlock"
                   Text=""
                   TextWrapping="Wrap"
                   MinHeight="60"
                   Margin="0 0 0 0" />

        <Button Content="{i18Ext:Localize Key=PurchaseAddon_ShowPurchaseUI}"
                Command="{x:Bind PurchaseAddonCommand}"
                HorizontalAlignment="Stretch"
                Style="{StaticResource AccentButtonStyle}"
                ctwu:FrameworkElementExtensions.Cursor="Hand" />

        <HyperlinkButton Content="{i18Ext:Localize Key=PurchaseAddon_ShowPurchaseHistory}"
                         NavigateUri="https://account.microsoft.com/billing/orders"
                         HorizontalAlignment="Stretch"
                         ctwu:FrameworkElementExtensions.Cursor="Hand" />
      </StackPanel>
    </Flyout>

  </Page.Resources>

  <Grid Background="{ThemeResource SystemControlAcrylicElementBrush}"
        HorizontalAlignment="Center"
        Padding="0 16 0 0"
        Margin="0 16 0 16"
        IsHitTestVisible="True"
        CornerRadius="6"
        BorderBrush="{ThemeResource SystemBaseMediumLowColor}"
        BorderThickness="1">
    <uwpControls:DockPanel>

      <Grid MaxWidth="600"
            uwpControls:DockPanel.Dock="Top"
                       >
        <Border Height="1"
                VerticalAlignment="Bottom"
                Background="{ThemeResource SystemBaseLowColor}" 
                Opacity="0.3"/>
        <StackPanel Orientation="Horizontal" Margin="0 0 0 8">
          <Button Command="{x:Bind BackNavigationRequestCommand}"
                  HorizontalAlignment="Left"
                  ctwu:FrameworkElementExtensions.Cursor="Hand"
                  VerticalAlignment="Stretch">
            <SymbolIcon Symbol="Back"
                        />
          </Button>

          <TextBlock Text="{i18Ext:Localize Key=Settings}" 
                     VerticalAlignment="Center"
                     TextLineBounds="TrimToCapHeight"
                     Style="{StaticResource TitleTextBlockStyle}"
                     Margin="16 0 0 0"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0 0 0 8">

          <Button Click="ShowPurchaseConfirmFlyoutMenuFlyoutItem_Click"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  x:Name="PurchaseAddonButton">
            <TextBlock Text="{i18Ext:Localize Key=PurchaseAddon_ButtonTitle}"
                       TextWrapping="Wrap" />
          </Button>
        </StackPanel>
      </Grid>
      
      <ScrollViewer>
        <StackPanel x:Name="ScrollViewerRootPanel" Padding="48 0 48 64">
          
          <ItemsControl ItemsSource="{x:Bind _vm.SettingGroups, Mode=OneWay}"
                        ItemTemplate="{StaticResource SettingsGroupTemplate}"
                        Margin="0 16"
                        IsTabStop="False"
                        HorizontalAlignment="Stretch"
                        MaxWidth="600"
                        x:Name="SettingsItemsControl"
                      >
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="16" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>

          <TextBlock Text="{i18Ext:Localize Key=AppInformation}"
                     Style="{StaticResource SubtitleTextBlockStyle}" />
          <uwpControls:SettingsCard MaxWidth="600"
                                    Header="{i18Ext:Localize Key=AppVersion}">
            
            <uwpControls:SettingsCard.Description>
              <TextBlock IsTextSelectionEnabled="True"
                         x:Name="ApplicationInfomationText"
                         TextWrapping="Wrap"
                         >
              </TextBlock>
            </uwpControls:SettingsCard.Description>
            <Button ToolTipService.ToolTip="{i18Ext:Localize Key=CopyAppInfoToClipboard}"
                    Command="{x:Bind AppInformationCopyToClipboardCommand}"
                    uwpControls:DockPanel.Dock="Right"
                    MinWidth="60">
              <SymbolIcon Symbol="Copy" />
            </Button>

          </uwpControls:SettingsCard>
          
          <uwpControls:SettingsCard>
            <HyperlinkButton Content="{i18Ext:Localize Key=OpenAppStorePage}"
                             NavigateUri="https://apps.microsoft.com/detail/9ndxxqrg4pl8"
                             HorizontalAlignment="Right" />
          </uwpControls:SettingsCard>

          <uwpControls:SettingsCard>
            <HyperlinkButton Content="{i18Ext:Localize Key=OpenAppUpdateHistory}"
                             NavigateUri="https://tor4kichi.github.io/tsubame_viewer/updates"
                             HorizontalAlignment="Right" />
          </uwpControls:SettingsCard>
          <uwpControls:SettingsCard>
            <HyperlinkButton Content="{i18Ext:Localize Key=PrivacyPolicy}"
                             NavigateUri="https://tor4kichi.github.io/tsubame_viewer/privacy-policy"
                             HorizontalAlignment="Right" />
          </uwpControls:SettingsCard>
          <uwpControls:SettingsCard>
            <HyperlinkButton Content="{i18Ext:Localize Key=ThirdPartyLibraryNotice}"
                             NavigateUri="https://tor4kichi.github.io/tsubame_viewer/Third-Party-Library-Notice"
                             HorizontalAlignment="Right" />
          </uwpControls:SettingsCard>

          <uwpControls:SettingsCard>
            <HyperlinkButton Content="{i18Ext:Localize Key=SendFeedbackWithStoreReview}"
                             Command="{x:Bind OpenStoreRatingPageCommand}" />
          </uwpControls:SettingsCard>
          <uwpControls:SettingsCard>
            <HyperlinkButton Content="{i18Ext:Localize Key=SendFeedbackForMsForm}"
                             Command="{x:Bind OpenMsFormFeedbackPageCommand}" />
          </uwpControls:SettingsCard>
          <uwpControls:SettingsCard>
            <HyperlinkButton Content="{i18Ext:Localize Key=AskQuestionWithMashmarrow}"
                             NavigateUri="https://marshmallow-qa.com/tor4kichi"
                             HorizontalAlignment="Right" />

          </uwpControls:SettingsCard>

          <!-- AdvancedSetting -->
          <!--<uwpControls:Expander Margin="32 64 32 32" Visibility="Collapsed">
            <uwpControls:Expander.Header>
              <TextBlock Text="{Binding Source=AdvancedSettings, Converter={StaticResource LocalizeConverter}}"
                     Style="{StaticResource SubtitleTextBlockStyle}"
                     />
            </uwpControls:Expander.Header>

            <ItemsControl ItemsSource="{x:Bind _vm.AdvancedSettingGroups, Mode=OneWay}"
                        ItemTemplate="{StaticResource SettingsGroupTemplate}"
                      Margin="32 16"
                          HorizontalAlignment="Left"
                          IsTabStop="False"
                      >
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="{StaticResource GroupSpacing}" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
          </uwpControls:Expander>-->          
        </StackPanel>
        
        
      </ScrollViewer>
    </uwpControls:DockPanel>

    <VisualStateManager.VisualStateGroups>
      <!-- 画面サイズによる表示切り替え -->
      <VisualStateGroup>
        <VisualState>
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="1220" />
          </VisualState.StateTriggers>
          <VisualState.Setters>
          </VisualState.Setters>
        </VisualState>
        <VisualState>
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="610" />
          </VisualState.StateTriggers>
          <VisualState.Setters>
          </VisualState.Setters>
        </VisualState>
        <VisualState>
          <VisualState.StateTriggers>
            <AdaptiveTrigger MinWindowWidth="0" />
          </VisualState.StateTriggers>
          <VisualState.Setters>
            <Setter Target="ScrollViewerRootPanel.Padding"
                    Value="16 0 16 64" />
          </VisualState.Setters>
        </VisualState>
      </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>
  </Grid>
</Page>
