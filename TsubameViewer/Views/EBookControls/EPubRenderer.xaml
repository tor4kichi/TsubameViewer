<UserControl
    x:Class="TsubameViewer.Views.EBookControls.EPubRenderer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TsubameViewer.Views.EBookControls"
    xmlns:winUI="using:Microsoft.UI.Xaml.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DesignHeight="300"
    d:DesignWidth="400">

  <Grid x:Name="PageBackground" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <winUI:WebView2 x:Name="WebView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    IsTapEnabled="False"
                    IsHitTestVisible="False"
                    IsAccessKeyScope="False"
                    AllowFocusOnInteraction="False"
                    GettingFocus="WebView_GettingFocus" />
  </Grid>
</UserControl>
