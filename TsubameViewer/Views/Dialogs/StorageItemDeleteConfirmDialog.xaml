<ContentDialog
  x:Class="TsubameViewer.Views.Dialogs.StorageItemDeleteConfirmDialog"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:local="using:TsubameViewer.Views.Dialogs"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:i="using:Microsoft.Xaml.Interactivity"
  mc:Ignorable="d"
  xmlns:i18nExt="using:I18NPortable.Xaml.Extensions"
  PrimaryButtonText="{i18nExt:Localize Key=Delete}"
  SecondaryButtonText="{i18nExt:Localize Key=Cancel}"
  >
  <Grid>
    <StackPanel Orientation="Horizontal" Spacing="8">
      <ToggleButton x:Name="DeleteWithPermanentToggleButton"
                    Width="24"
                    Height="24">
        
      </ToggleButton>
      <TextBlock Text="{i18nExt:Localize Key=StorageItemDeleteConfirm_IsDeletePermanent}" VerticalAlignment="Center">
        <i:Interaction.Behaviors>
          <i:EventTriggerBehavior EventName="Tapped">
            <i:ChangePropertyAction TargetObject="{x:Bind DeleteWithPermanentToggleButton}"
                                    PropertyName="IsChecked"
                                    Value="{x:Bind DeleteWithPermanentToggleButton.IsChecked, Mode=OneWay, Converter={StaticResource BoolNegationConverter}}" />
          </i:EventTriggerBehavior>
                                     
        </i:Interaction.Behaviors>
      </TextBlock>
    </StackPanel>
    
  </Grid>
</ContentDialog>
