<UserControl
    x:Class="TsubameViewer.Views.SecondaryAppShell"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TsubameViewer.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:uwpControls="using:CommunityToolkit.WinUI.Controls"
             mc:Ignorable="d"
    d:DesignHeight="300"
    d:DesignWidth="400"  >

  <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid Opacity="0"
          IsHitTestVisible="False">
      <Button>
        <Button.KeyboardAccelerators>
          <KeyboardAccelerator Key="F11"
                               Invoked="ToggleFullScreenKeyboardAccelerator_Invoked" />
          <KeyboardAccelerator Key="Escape"
                               Invoked="ExitViewerKeyboardAccelerator_Invoked" />
        </Button.KeyboardAccelerators>
      </Button>
    </Grid>
    <Frame x:Name="MyFrame"            
           HorizontalAlignment="Stretch"
           VerticalAlignment="Stretch"
           CacheSize="0"/>

    <uwpControls:DockPanel HorizontalAlignment="Left"
                           VerticalAlignment="Top"
                           Visibility="{x:Bind _windowContext.NowDisplayTitleBar, Mode=OneWay}">
      <TextBlock Text="TsubameViewer"
                 x:Name="TitleText"
                 uwpControls:DockPanel.Dock="Top"
                 Margin="12"
                 VerticalAlignment="Center"/>

      <DropDownButton>
        <Image Source="/Assets/Square44x44Logo.png"               
               Width="24" />

        <DropDownButton.Flyout>
          <Flyout>
            <StackPanel>
              <ContentControl x:Name="TitleBarContent"
                              HorizontalContentAlignment="Stretch"
                              VerticalContentAlignment="Stretch"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch" />
            </StackPanel>
          </Flyout>
        </DropDownButton.Flyout>
      </DropDownButton>

    </uwpControls:DockPanel>
  </Grid>
</UserControl>
